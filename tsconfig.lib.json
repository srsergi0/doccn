{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/index.ts",
    "src/components/document/primitives/**/*",
    "src/components/document/blocks/**/*",
    "src/lib/**/*"
  ],
  "exclude": [
    "src/docs/**/*",
    "src/templates/**/*",
    "src/App.tsx",
    "src/main.tsx"
  ]
}
